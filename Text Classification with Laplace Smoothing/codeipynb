      "cell_type": "markdown",
      "source": [
        "**Training Data**"
      ],
      "metadata": {
        "id": "uaJkax_ME79u"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "docs = [\n",
        "    (\"Taipei Taiwan\", \"c\"),\n",
        "    (\"Macao Taiwan Shanghai\", \"c\"),\n",
        "    (\"Japan Sapporo\", \"j\"),\n",
        "    (\"Sapporo Osaka Taiwan\", \"j\")\n",
        "]\n",
        "\n",
        "test_doc = \"Taiwan Taiwan Sapporo\""
      ],
      "metadata": {
        "id": "iQpeELOf2bBS"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "**Preprocessing**"
      ],
      "metadata": {
        "id": "5MIdVlPBFCSd"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from collections import defaultdict\n",
        "\n",
        "def tokenize(text):\n",
        "    return text.lower().split()\n",
        "\n",
        "# Vocabulary\n",
        "vocab = set()\n",
        "\n",
        "# Word counts per class\n",
        "word_counts = defaultdict(lambda: defaultdict(int))\n",
        "\n",
        "# Document count per class\n",
        "class_counts = defaultdict(int)\n",
        "\n",
        "# Total words per class\n",
        "total_words = defaultdict(int)\n",
        "\n",
        "# Build model\n",
        "for text, cls in docs:\n",
        "    class_counts[cls] += 1\n",
        "    words = tokenize(text)\n",
        "\n",
        "    for word in words:\n",
        "        vocab.add(word)\n",
        "        word_counts[cls][word] += 1\n",
        "        total_words[cls] += 1\n",
        "\n",
        "vocab_size = len(vocab)\n",
        "\n",
        "print(\"Vocabulary:\", vocab)\n",
        "print(\"Class Counts:\", dict(class_counts))\n",
        "print(\"Total Words per Class:\", dict(total_words))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "duvTFfqx2jwH",
        "outputId": "5457fc69-6d61-44a6-eb6a-19c7b3c22bd5"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Vocabulary: {'sapporo', 'macao', 'shanghai', 'taipei', 'osaka', 'japan', 'taiwan'}\n",
            "Class Counts: {'c': 2, 'j': 2}\n",
            "Total Words per Class: {'c': 5, 'j': 5}\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "**Prior Probabilities**"
      ],
      "metadata": {
        "id": "gejeiSzjFHS5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "total_docs = len(docs)\n",
        "\n",
        "priors = {}\n",
        "for cls in class_counts:\n",
        "    priors[cls] = class_counts[cls] / total_docs\n",
        "\n",
        "print(\"\\nPriors:\", priors)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "rH6LLfQpEH-r",
        "outputId": "e4bae344-e653-409b-f540-763d44acb74f"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Priors: {'c': 0.5, 'j': 0.5}\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "**Conditional Probabilities (Laplace smoothing)**"
      ],
      "metadata": {
        "id": "q0KukGlAFUT6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def conditional_prob(word, cls):\n",
        "    return (word_counts[cls][word] + 1) / (total_words[cls] + vocab_size)"
      ],
      "metadata": {
        "id": "sjol3g1WEO7E"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "**Compute Posterior**"
      ],
      "metadata": {
        "id": "POflxtO6FZUp"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import math\n",
        "\n",
        "def compute_posterior(test_doc, cls):\n",
        "    words = tokenize(test_doc)\n",
        "\n",
        "    log_prob = math.log(priors[cls])  # use log to avoid underflow\n",
        "\n",
        "    for word in words:\n",
        "        prob = conditional_prob(word, cls)\n",
        "        log_prob += math.log(prob)\n",
        "\n",
        "    return log_prob"
      ],
      "metadata": {
        "id": "oqtnhbTqEmka"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "**Prediction**"
      ],
      "metadata": {
        "id": "y8zq3zuPFf5V"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "scores = {}\n",
        "\n",
        "for cls in class_counts:\n",
        "    scores[cls] = compute_posterior(test_doc, cls)\n",
        "\n",
        "print(\"\\nLog Posterior Scores:\", scores)\n",
        "\n",
        "# Choose max\n",
        "predicted_class = max(scores, key=scores.get)\n",
        "\n",
        "print(\"\\nPredicted Class:\", predicted_class)"
      ],
